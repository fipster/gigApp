{
  "gathered_on": "2026-07-25",
  "_generation_notes": {
    "purpose": "Nonstop destinations from Tallinn (TLL) and Riga (RIX), with flight duration and seasonal-route info, used by scraper.py to populate flightTLL/flightRIX on each show.",
    "sources": {
      "wikipedia": [
        "https://en.wikipedia.org/wiki/Riga_International_Airport",
        "https://en.wikipedia.org/wiki/Tallinn_Airport"
      ],
      "flightconnections": [
        "https://www.flightconnections.com/flights-from-tallinn-tll",
        "https://www.flightconnections.com/flights-from-riga-rix"
      ]
    },
    "precedence_rule": "On conflict, Wikipedia's Regular/Seasonal classification for a route is authoritative for the `seasonal` boolean (Wikipedia's airport destination tables are maintained and don't show the false-seasonal artifacts flightconnections.com's data can have). flightconnections.com is used only for `duration_minutes` (reliable, stable) and, when both sources agree a route is seasonal, for the specific `seasonal_months` range.",
    "why_flightconnections_seasonal_flag_is_not_trusted": "flightconnections.com's per-destination `mths` bitmask appears to reflect whatever schedule window is currently loaded in their system rather than a route's true recurring season — e.g. it showed Tallinn-Dublin as seasonal (Dec-Aug) despite Wikipedia confirming Ryanair's TLL-Dublin route is year-round. Do not trust its seasonal boolean standalone.",
    "flightconnections_api_technique": {
      "description": "flightconnections.com renders as a JS map with no accessible destination list, but the underlying data loads from a JSON endpoint visible in the network tab.",
      "endpoint_pattern": "https://www.flightconnections.com/rt<AIRPORT_ID>.json?v=<version>&lang=en&f=no0&direction=from&...",
      "airport_ids": {
        "TLL": 294,
        "RIX": 256
      },
      "how_to_find_airport_id": "Navigate to https://www.flightconnections.com/flights-from-<city>-<iata> in a real browser, open network requests, look for the rtNNN.json call.",
      "response_shape": {
        "lst": "array of [IATA, city, countryCode, countryName, durationMinutes(string), distanceKm(string), classCode] for each nonstop destination",
        "mths": "array of 12-bit integer bitmasks, one per destination PLUS a leading 0 for the origin itself (so mths[1:] aligns with lst[0:]); 4095 = all 12 bits set = year-round; any other non-zero value = seasonal with only some months' bits set"
      },
      "month_bit_decoding": {
        "formula": "for bit index i in 0..11: calendar_month = (BIT0_MONTH + i) % 12, where BIT0_MONTH = 2 (March, 0-indexed Jan=0)",
        "calibration_evidence": "Verified against two Wikipedia-confirmed exact route-start dates: Riga–Kuusamo 'begins 11 December 2026' decodes to Dec–Mar under this formula (December included, consistent with a Dec-11 start); Riga–Turin 'begins 30 January 2027' decodes to Dec–Feb (January included). This is empirical calibration, not from official documentation — re-verify if the site's data format changes.",
        "caveat": "Even with correct bit decoding, treat flightconnections' seasonal date ranges as approximate hints only, per precedence_rule above — they can reflect data-loading gaps rather than true seasonality."
      }
    },
    "city_normalization": "Both sources' destination names are normalized by stripping airport disambiguation (e.g. 'Rome–Fiumicino' / 'Rome (Fiumicino)' → 'Rome', 'London–Gatwick' / 'London Gatwick' → 'London') so they key consistently and match the plain city names Ticketmaster returns for venues.",
    "how_to_refresh": "Re-fetch the two Wikipedia pages' 'Airlines and destinations' tables, and re-fetch both rtNNN.json endpoints (ids above, or re-derive via network tab if flightconnections changes airport IDs), then re-run the precedence_rule merge above. Update `gathered_on` to the new date."
  },
